{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "/usr/bin/python3 .cursor/hooks/qa_guard.py",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "/usr/bin/python3 .cursor/hooks/qa_guard.py",
        "matcher": "Write|StrReplace|Delete|EditNotebook",
        "timeout": 5,
        "failClosed": true
      }
    ]
  }
}
