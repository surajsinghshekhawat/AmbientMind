{
  "name": "ambientmind",
  "version": "0.1.0",
  "description": "Ambient desktop overlay that auto-populates your todo list from email, calendar and voice using a local LLM.",
  "main": "./out/main/main.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.cjs",
    "check:migration": "electron ./scripts/check-migration.cjs",
    "smoke:sqlite": "electron ./scripts/smoke-sqlite.cjs",
    "smoke:vec": "electron ./scripts/smoke-vec.cjs && electron ./scripts/smoke-vecstore.cjs",
    "test": "node --import tsx --test \"eval/**/*.test.ts\"",
    "eval": "tsx eval/evaluate.ts",
    "eval:prepare": "tsx eval/prepare-enron.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sqlite-vec": "^0.1.9",
    "tesseract.js": "^7.0.0"
  }
}
