{
  "name": "ambientmind",
  "version": "0.2.0",
  "description": "Ambient desktop overlay that auto-populates your todo list from email, calendar and voice using a local LLM.",
  "main": "./out/main/main.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:seed": "electron-vite dev -- --seed",
    "gallery": "vite --config gallery.config.ts",
    "gallery:shots": "electron scripts/gallery-shots.cjs",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.cjs",
    "check:migration": "electron ./scripts/check-migration.cjs",
    "corpus:export": "electron . --export-corpus",
    "sync:now": "electron . --sync-now",
    "preflight": "node scripts/preflight-dist.cjs",
    "helper": "node scripts/build-helper.cjs",
    "dist": "node scripts/require-isolation.cjs && npm run preflight && npm run helper && npm run build && electron-builder",
    "dist:mac": "node scripts/require-isolation.cjs && npm run preflight && npm run helper && npm run build && electron-builder --mac",
    "dist:win": "node scripts/require-isolation.cjs && npm run preflight && npm run build && electron-builder --win",
    "sign:setup": "node scripts/mac-sign.cjs setup",
    "smoke:sqlite": "electron ./scripts/smoke-sqlite.cjs",
    "smoke:vec": "electron ./scripts/smoke-vec.cjs && electron ./scripts/smoke-vecstore.cjs",
    "test": "npm run test:logic && npm run test:db && npm run test:ui",
    "test:db": "node scripts/test-db.cjs",
    "test:logic": "node --import tsx --test \"eval/**/*.test.ts\"",
    "test:ui": "vitest run",
    "test:smoke": "electron-vite build && playwright test e2e/smoke.spec.ts",
    "test:packaged": "node scripts/test-packaged.cjs",
    "measure:idle": "electron-vite build && playwright test e2e/idle.spec.ts",
    "qa": "node scripts/qa-run.cjs",
    "qa:build": "node scripts/require-isolation.cjs && npm run helper && npm run build && electron-builder --mac --config.directories.output=.local/qa/build",
    "qa:verify": "node scripts/qa-verify.cjs",
    "qa:missions": "electron-vite build && playwright test e2e/qa",
    "eval": "tsx eval/evaluate.ts",
    "eval:chat": "tsx eval/chatActions.ts",
    "ai:budget": "tsx scripts/ai-budget.ts",
    "eval:prepare": "tsx eval/prepare-enron.ts",
    "postinstall": "node scripts/require-isolation.cjs && electron-builder install-app-deps"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "axe-core": "^4.14.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.1",
    "electron-vite": "^4.0.0",
    "happy-dom": "^21.0.4",
    "lucide-react": "1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.1.11",
    "thinking-orbs": "0.3.2",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.3",
    "sqlite-vec": "^0.1.9",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@6.11.6": true,
    "sharp@0.32.6": true,
    "tesseract.js": false,
    "electron@45.2.1": true
  }
}
